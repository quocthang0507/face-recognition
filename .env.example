# Replace every development credential before exposing the server.
# The password below only creates the "admin" account on the first start.
FACE_APP_TEACHER_PASSWORD=change-me
FACE_APP_TOKEN_SECRET=development-only-change-this-secret

# Production deployment should terminate TLS at a reverse proxy and enable:
# FACE_APP_SECURE_COOKIE=true
# FACE_APP_SECURE_TRANSPORT_ONLY=true
# FACE_APP_ALLOWED_ORIGINS=https://classroom.example.com

# Minutes after the lesson starts before a check-in is marked late.
# FACE_APP_LATE_AFTER_MINUTES=15

# Performance tuning (see docs/planning/architecture-proposal.md, section 7).
# FACE_APP_BEHAVIOR_FPS=8
# FACE_APP_HAND_FPS=3
# FACE_APP_MAX_FACES=8
# FACE_APP_EMBED_DETECTOR=skip
# FACE_APP_PROFILE=false
